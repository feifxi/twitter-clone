# Google OAuth Web client ID for social login
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# Server-side only (SSR, proxy.ts). Optional: defaults to NEXT_PUBLIC_API_URL; in production the
# API sits next to the web container (http://api:8080/api/v1) and browsers use the relative /api/v1.
# API_INTERNAL_URL=
