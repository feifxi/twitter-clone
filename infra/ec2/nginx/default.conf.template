# The site: TLS termination, routing (/api → Go API, everything else → Next.js) and
# streaming for server-sent events. The nginx image renders this template at start,
# filling in ${SITE_DOMAIN} from the environment.

# Docker's DNS. Containers get new IPs when a deploy recreates them, so upstreams are
# re-resolved (`resolve`) instead of being looked up once at startup.
resolver 127.0.0.11 valid=10s ipv6=off;

upstream api {
    zone api 64k;
    server api:8080 resolve;
    keepalive 16;
}

upstream web {
    zone web 64k;
    server web:3000 resolve;
    keepalive 16;
}

server_tokens off;

# Which upstream served the request, for logs and metrics. Event streams stay open for
# minutes, so they get their own label instead of skewing the API's latency.
map $uri $service {
    ""                            none; # no HTTP request at all (bare TLS probes, scanners)
    ~^/api/v1/(events|assistant)$ stream;
    ~^/(api/|healthz$|readyz$)    api;
    default                       web;
}

# One JSON line per request. Alloy ships them to Loki and derives the edge metrics
# (request rate, status codes, latency) from them.
log_format json escape=json '{"time":"$time_iso8601","service":"$service","method":"$request_method",'
    '"path":"$uri","status":$status,"bytes":$body_bytes_sent,"request_time":$request_time,'
    '"upstream_time":"$upstream_response_time","remote_addr":"$remote_addr",'
    '"user_agent":"$http_user_agent","request_id":"$request_id"}';

server {
    listen 80 default_server;
    server_name ${SITE_DOMAIN};
    access_log /dev/stdout json;

    # Let's Encrypt HTTP-01 challenges, answered from the webroot certbot writes to.
    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    # Container health check (docker compose up --wait).
    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        return 308 https://${SITE_DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${SITE_DOMAIN};
    access_log /dev/stdout json;

    # Written by certbot (a placeholder until the first certificate is issued); nginx
    # reloads itself when they change (see reload-on-cert-change.sh).
    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;

    # Mozilla "intermediate" TLS profile.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=63072000" always;

    # Media uploads go straight to S3 (presigned), so request bodies here are small.
    client_max_body_size 2m;

    gzip on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    # Replace, never append: a client can't smuggle in a fake IP (the API rate-limits by it).
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Same ID in nginx's and the API's logs.
    proxy_set_header X-Request-ID $request_id;

    # Prometheus metrics are scraped inside the Docker network, never served publicly.
    location = /metrics {
        return 404;
    }

    # Server-sent events (notifications/DMs, assistant replies): pass each event through
    # immediately and keep idle streams open (the API sends heartbeats).
    location ~ ^/api/v1/(events|assistant)$ {
        proxy_pass http://api;
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    location ~ ^/(api/|healthz$|readyz$) {
        proxy_pass http://api;
    }

    location / {
        proxy_pass http://web;
    }
}
