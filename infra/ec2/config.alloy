// Ships API + host metrics to Grafana Cloud Prometheus and API logs to Loki.
// Credentials come from monitoring.env (rendered from SSM by deploy.sh).

prometheus.scrape "api" {
  targets    = [{"__address__" = "api:8080", "job" = "twitter-api"}]
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.scrape "node_exporter" {
  targets    = [{"__address__" = "node-exporter:9100", "job" = "node-exporter"}]
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_PROMETHEUS_URL")
    basic_auth {
      username = sys.env("GRAFANA_PROMETHEUS_USER")
      password = sys.env("GRAFANA_API_TOKEN")
    }
  }
}

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "api_logs" {
  targets = discovery.docker.containers.targets

  // Keep only the API service of this Compose project.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "api"
    action        = "keep"
  }
  rule {
    target_label = "job"
    replacement  = "twitter-api"
  }
}

loki.source.docker "api" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.api_logs.output
  forward_to = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_LOKI_URL")
    basic_auth {
      username = sys.env("GRAFANA_LOKI_USER")
      password = sys.env("GRAFANA_API_TOKEN")
    }
  }
}
