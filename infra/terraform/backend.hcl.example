# Copy to backend.hcl and run: terraform init -backend-config=backend.hcl
# The bucket comes from ../bootstrap (terraform output state_bucket).
bucket       = "chmtwt-tfstate-123456789012"
key          = "prod/terraform.tfstate"
region       = "ap-southeast-1"
encrypt      = true
use_lockfile = true # S3-native state locking (no DynamoDB table needed)
