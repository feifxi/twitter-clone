# Copy to terraform.tfvars (gitignored) and fill in.

# ── Domains ─────────────────────────────────────────
root_domain     = "chanombude.me"
web_domain      = "twitter.chanombude.me"
api_domain      = "api.chanombude.me"
acme_email      = "you@example.com"
route53_zone_id = "" # set if Route 53 hosts root_domain; otherwise add the dns_records output by hand

# Lets a local frontend upload media to this environment's bucket.
dev_origins = ["http://localhost:3000"]

# ── Database ────────────────────────────────────────
db_username = "twitter_admin"
db_password = "CHANGE_ME_letters_digits_only_16plus" # openssl rand -hex 24

# ── Auth ────────────────────────────────────────────
token_symmetric_key = "CHANGE_ME" # openssl rand -base64 48
google_client_id    = "YOUR_CLIENT_ID.apps.googleusercontent.com"

# ── Assistant (optional) ────────────────────────────
gemini_api_key = "" # https://aistudio.google.com/

# ── GitHub ──────────────────────────────────────────
gh_repo_url = "https://github.com/feifxi/twitter-monolith"
gh_branch   = "main"
gh_token    = "github_pat_..." # fine-grained PAT, read access to the repo (used by Amplify)
# create_github_oidc_provider = false  # if the account already has one

# ── Grafana Cloud (optional) ────────────────────────
# grafana_cloud_prometheus_url  = "https://prometheus-prod-....grafana.net/api/prom/push"
# grafana_cloud_prometheus_user = "12345"
# grafana_cloud_loki_url        = "https://logs-prod-....grafana.net/loki/api/v1/push"
# grafana_cloud_loki_user       = "67890"
# grafana_cloud_api_token       = "glc_..."
