# Copy to terraform.tfvars (git-ignored). Every secret is generated by Terraform.
delegation_set_id = "N0123456789ABCDEFGHIJ" # terraform -chdir=infra/terraform/bootstrap output delegation_set_id
alert_email       = "you@example.com"       # AWS alarms and the budget; confirm the SNS email after each up
google_client_id  = "YOUR_CLIENT_ID.apps.googleusercontent.com"

# Optional
# domain              = "twitter.chanombude.me"
# gemini_api_key      = ""                                   # turns on the AI assistant
# discord_webhook_url = "https://discord.com/api/webhooks/..." # app alerts from Alertmanager
# dev_origins         = ["http://localhost:3000"]           # upload media from local dev
