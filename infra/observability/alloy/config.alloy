// Ships every container's logs to Loki, labelled by compose service. Same file locally
// (`docker compose --profile observability up -d`) and on the host.
// UI: http://localhost:12345 locally.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.process.containers.receiver]
}

loki.process "containers" {
  // The API (slog) and Caddy (access log) write JSON lines: index the level so errors are one
  // click away. Other fields (status, path, request ID) stay searchable with `| json`.
  stage.match {
    selector = "{service=~\"api|caddy\"}"

    stage.json {
      expressions = {level = "level"}
    }
    // slog writes ERROR, Caddy writes error: one spelling for queries
    stage.template {
      source   = "level"
      template = "{{ ToLower .Value }}"
    }
    stage.labels {
      values = {level = ""}
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
