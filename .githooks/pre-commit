#!/bin/sh
# Fast checks on staged files only (the full suite runs in CI).
# Enable once per clone: git config core.hooksPath .githooks
# Skip in an emergency:  git commit --no-verify

staged() { git diff --cached --name-only --diff-filter=ACMR | grep -E "$1" || true; }
failed=0

go_files=$(staged '^twitter-go-api/.*\.go$')
if [ -n "$go_files" ]; then
  unformatted=$(gofmt -l $go_files)
  if [ -n "$unformatted" ]; then
    echo "pre-commit: Go files need formatting:"; echo "$unformatted" | sed 's/^/  /'
    echo "  fix: gofmt -w $(echo $unformatted)"
    failed=1
  fi
fi

tf_files=$(staged '^infra/.*\.tf(test\.hcl)?$')
if [ -n "$tf_files" ] && command -v terraform >/dev/null 2>&1; then
  unformatted=$(terraform fmt -check -list=true $tf_files 2>/dev/null)
  if [ -n "$unformatted" ]; then
    echo "pre-commit: Terraform files need formatting:"; echo "$unformatted" | sed 's/^/  /'
    echo "  fix: terraform fmt $(echo $unformatted)"
    failed=1
  fi
fi

web_files=$(staged '^twitter-next-web/src/.*\.(ts|tsx)$' | sed 's#^twitter-next-web/##')
if [ -n "$web_files" ]; then
  if ! (cd twitter-next-web && npx --no-install eslint --max-warnings=0 $web_files); then
    echo "pre-commit: ESLint failed (fix the issues above)"
    failed=1
  fi
fi

exit $failed
