# Local development settings. Copy to app.env (gitignored); real environments
# set these as environment variables instead. Durations use Go syntax: 15m, 720h.

# ── Runtime ──────────────────────────────────────────
# "production" enables JSON logs, release mode and stricter validation
ENVIRONMENT=development
# debug | info | warn | error
LOG_LEVEL=info
HTTP_SERVER_ADDRESS=0.0.0.0:8080

# ── Database (PostgreSQL + pgvector) ─────────────────
DATABASE_URL=postgresql://root:rootpass@localhost:5432/twitter_db?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=0
DB_MAX_CONN_LIFETIME=5m

# ── Redis (optional) ─────────────────────────────────
# Without it the API runs single-instance: in-memory rate limits and realtime fan-out.
REDIS_URL=redis://localhost:6379

# ── HTTP / CORS ──────────────────────────────────────
# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000
# Shared secret a reverse proxy must send in X-Gateway-Secret. Leave empty locally.
GATEWAY_SECRET=

# ── Auth ─────────────────────────────────────────────
# At least 32 characters. Generate one: openssl rand -base64 32
TOKEN_SYMMETRIC_KEY=replace-with-a-strong-32-plus-char-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ── Media (S3 + CloudFront) ──────────────────────────
S3_BUCKET_NAME=
S3_REGION=ap-southeast-1
# without https://; empty serves straight from the bucket
CLOUDFRONT_DOMAIN=
# 100 MiB
MAX_MEDIA_BYTES=104857600
# 5 MiB
MAX_AVATAR_BYTES=5242880
# 10 MiB
MAX_BANNER_BYTES=10485760

# ── Assistant (Gemini) & RAG ─────────────────────────
# Get a key at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview
ENABLE_RAG=true
# temporary; replaced by the in-process embedding worker
SQS_EMBEDDING_QUEUE_URL=
